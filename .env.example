NODE_ENV=development
PORT=3000

# A fresh, empty database; create the schema with `npm run migrate`
DATABASE_URL=postgres://user:password@localhost:5432/vyaparsetu_dev

# Separate throwaway database used only by `npm test`
DATABASE_URL_TEST=postgres://user:password@localhost:5432/vyaparsetu_test

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Public address of this API, used in invoice share links
# (defaults to the address the request came in on)
PUBLIC_BASE_URL=https://api.example.com

# Email for password reset codes and invoices. Without SMTP_HOST nothing is
# sent; in development the email is printed to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VyaparSetu <no-reply@example.com>"

# Comma-separated browser origins allowed to send credentials (optional)
CORS_ORIGINS=

LOG_LEVEL=
