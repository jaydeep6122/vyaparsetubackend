NODE_ENV=development
PORT=3000

# A fresh, empty database; create the schema with `npm run migrate`
DATABASE_URL=postgres://user:password@localhost:5432/vyaparsetu_dev

# Separate throwaway database used only by `npm test`
DATABASE_URL_TEST=postgres://user:password@localhost:5432/vyaparsetu_test

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Comma-separated browser origins allowed to send credentials (optional)
CORS_ORIGINS=

LOG_LEVEL=
